<Project Sdk="Microsoft.NET.Sdk">

  <!-- Retargeted to SDK-style net10.0 so the parser tests run cross-platform
       (macOS/Linux/Windows) alongside the netstandard2.0 library. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>UnitTestPdbLibrary</RootNamespace>
    <AssemblyName>UnitTestPdbLibrary</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdbLibrary\PdbLibrary.csproj" />
  </ItemGroup>

  <!-- Ship the sample PE/PDB fixtures next to the test binary so tests resolve
       them via TestContext.CurrentContext.TestDirectory on any OS. -->
  <ItemGroup>
    <None Include="testdata\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>testdata\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>
